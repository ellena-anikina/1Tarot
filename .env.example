# Шаблон настроек. Скопируйте в .env.local и заполните (подробные пояснения — в README.md).
# На хостинге (например, Vercel) те же переменные задаются в настройках проекта.

AI_API_KEY=
AI_PROVIDER=
AI_MODEL=
AI_BASE_URL=

# Запасные модели — по желанию: включаются по очереди, если основная не ответила.
AI_API_KEY_2=
AI_PROVIDER_2=
AI_MODEL_2=
AI_BASE_URL_2=
AI_API_KEY_3=
AI_PROVIDER_3=
AI_MODEL_3=
AI_BASE_URL_3=

# Глубина размышлений модели: low | medium | high. Пусто — Claude думает на low, остальные модели — как решит провайдер.
AI_EFFORT=
READINGS_PER_HOUR=20

# Оплата: mock — тестовая (деньги не списываются, страница /oplata), off — все расклады бесплатно.
# Цены — в src/config/pricing.ts.
PAYMENTS_MODE=mock
# Секрет для подписи подтверждений оплаты — длинная случайная строка. На хостинге задать обязательно.
PAYMENTS_SECRET=
# Запасная защита бесплатной подсказки: сколько бесплатных подсказок в сутки сервер пропускает с одного адреса
# (основной лимит «раз в день» считает браузер). Пусто — 3, 0 — проверка выключена.
FREE_PER_IP_PER_DAY=
NEXT_PUBLIC_SITE_URL=https://example.ru
# 1 — тестовая версия (например, на Vercel): поисковики не добавят её страницы в выдачу. На настоящем домене не задавать.
SITE_NOINDEX=
